@import "../menu.rasi"

textbox-prompt-colon {
    str:                         " System";
}
listview     { columns: 5; }
element      { padding: 20px 10px; }
// Propo, not the mono variant: mono gives every icon a one-cell advance its ink
// overflows to the right, so centring by advance left each label off-centre.
element-text { font: "FiraCode Nerd Font Propo 26"; }
