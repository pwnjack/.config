//
// WAYBAR CONFIG - Original by ML4W (https://www.ml4w.com)
// MODIFIED BY @GeodeArc
//

{
  // General Settings
  "layer": "bottom",
  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "height": 0,

  // Modules Left
  "modules-left": ["hyprland/window", "wlr/taskbar"],

  // Modules Center
  "modules-center": [
    "hyprland/workspaces",
    "clock",
    "custom/weather",
    "custom/media",
  ],

  // Modules Right
  "modules-right": [
    "cpu",
    "memory",
    "custom/gpu",
    "disk",
    "network",
    "bluetooth",
    "battery",
    "pulseaudio",
    "tray",
    "custom/nightlight",
    "custom/settings",
    "custom/sidebar",
    "custom/power",
  ],

  // Workspaces
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "on-click": "activate",
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "urgent": "",
      "active": "●",
      "default": "●",
      "empty": "○",
    },
    "persistent-workspaces": {
      // Explicit IDs, never a bare count. Waybar reads `"*": 5` as five
      // workspaces *in addition to* the ones that already exist, so the bar
      // grew to eight buttons as soon as three workspaces were in use. A list
      // pins exactly which IDs are always shown.
      "*": [1, 2, 3, 4, 5],
    },
  },

  // Taskbar
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "sort-by-app-id": false,
    "on-click": "activate",
    "on-click-middle": "close",
    "all-outputs": true,
    "ignore-list": ["alacritty", "foot"],
  },

  // Hyprland Window
  "hyprland/window": {
    "max-length": 50,
    "separate-outputs": false,
    "rewrite": {
      // SYS/BASE PROGRAMS
      "": " Hyprland",

      "~": "  Terminal",
      "zsh": "  Terminal",

      "VLC media player": "󰕼  VLC Media Player",
      "(.*) - VLC media player": "󰕼  VLC | $1",

      "(.*) - mpv": "  MPV | $1",

      "Authenticate": "󰻌  Authenticate",

      // MISC
      "• Discord(.*)": "Discord$1",
      "(.*)Discord(.*)": "  $1Discord$2",
    },
  },

  // Night Light
  // State comes from the hyprsunset daemon via nightlight.sh, so the icon
  // reflects what is actually applied. Signal 8 lets the script refresh the
  // module the instant it changes something; the interval only has to catch
  // the daemon's own scheduled profile switches.
  "custom/nightlight": {
    "format": "{}",
    "return-type": "json",
    "interval": 60,
    "signal": 8,
    "exec": "~/.config/scripts/hyprland/nightlight.sh waybar",
    "on-click": "~/.config/scripts/hyprland/nightlight.sh toggle",
    "on-click-right": "~/.config/scripts/hyprland/nightlight.sh auto",
  },

  // Settings
  "custom/settings": {
    "format": "󰢻",
    "on-click": "astal -i settings-panel --toggle-window settings-panel",
    "tooltip-format": "Settings",
  },

  // System tray
  "tray": {
    "icon-size": 16,
    "spacing": 10,
  },

  // Clock
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d-%m-%Y}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      // Hierarchy by alpha, never by hue. config.jsonc cannot reach the
      // pywal palette -- @foreground is a CSS variable and these are Pango
      // markup -- so a literal colour here would be the one thing on the bar
      // that ignores the wallpaper. alpha dims whatever colour the tooltip
      // already inherited from `tooltip label` in style.css.
      "format": {
        "months": "{}",
        "days": "{}",
        "weeks": "<span alpha='55%'>W{}</span>",
        "weekdays": "<span alpha='75%'>{}</span>",
        "today": "<b>{}</b>",
      },
    },
    "actions": {
      "on-click-middle": "mode",
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up",
    },
  },

  // Weather
  "custom/weather": {
    "format": "{}",
    "exec": "~/.config/waybar/waybar-weather-wrapper.sh",
    "return-type": "json",
    "interval": 600,
    "tooltip": true,
  },

  // CPU
  "cpu": {
    "interval": 5,
    "format": "<span size='large'></span>  {usage}%",
    "on-click": "resources",
    "tooltip": true,
    "tooltip-format": "CPU {usage}% [{avg_frequency}GHz]\n\nCore0: {usage0}%  Core1: {usage1}%\nCore2: {usage2}%  Core3: {usage3}%\nCore4: {usage4}%  Core5: {usage5}%\nCore6: {usage6}%  Core7: {usage7}%",
  },

  // Memory
  "memory": {
    "interval": 5,
    "format": "<span size='large'></span>  {}%",
    "on-click": "resources",
    "tooltip": true,
    "tooltip-format": "Memory {percentage}% [{used}GB / {total}GB]\n\nSwap: {swapPercentage}% [{swapUsed}GB / {swapTotal}GB]",
  },

  // GPU with Temperature
  "custom/gpu": {
    "interval": 5,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "on-click": "resources",
  },

  // Disk
  "disk": {
    "interval": 30,
    "format": "<span size='large'></span>  {percentage_used}%",
    "path": "/",
    "on-click": "resources",
    "tooltip": true,
    "tooltip-format": "Disk {percentage_used}%\n\nUsed: {used} / {total}\nFree: {free}",
  },

  // Network
  "network": {
    "format": "<span size='large'>󰲛</span>  Offline",
    "format-wifi": "<span size='large'>{icon}</span>",
    // Signal ramp, the way battery and pulseaudio already work.
    // Dormant on this wired desktop; groundwork for a laptop host.
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "<span size='large'>󰈀</span>",
    "format-linked": "<span size='large'>󰈀</span>",
    "format-disconnected": "<span size='large'>󰲛</span>  Offline",
    "tooltip-format": "󰈀 {ifname} via {gwaddri}",
    "tooltip-format-wifi": " Connected \n\nIP: {ipaddr}\nStrength: {signalStrength}%\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": "󰈀 {ifname}\n\nIP: {ipaddr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "nm-connection-editor",
  },

  // Battery
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "<span size='large'>{icon}</span>  {capacity}%",
    "format-charging": "<span size='large'></span>  {capacity}%",
    "format-plugged": "<span size='large'></span>  {capacity}%",
    "format-alt": "<span size='large'>{icon}</span>  {time}",
    "format-icons": ["", "", "", "", ""],
  },

  // Pulseaudio
  "pulseaudio": {
    "scroll-step": 2,
    "format": "<span size='large'>{icon}</span>  {volume}%",
    "format-bluetooth": "<span size='large'>{icon}</span>  {volume}% <span size='large'></span>",
    "format-bluetooth-muted": "<span size='large'></span>  Muted <span size='large'></span>",
    "format-muted": "<span size='large'></span>  Muted",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", "", ""],
    },
    "tooltip-format": "{desc}\n\nVolume: {volume}%\nMic: {format_source}",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
  },
  // Bluetooth
  "bluetooth": {
    "format": "<span size='large'></span>",
    "format-disabled": "<span size='large'> </span>",
    "format-off": "<span size='large'></span>  Off",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": "",
    "tooltip-format": " {controller_alias}\n\n{num_connections} connected",
    "tooltip-format-connected": " {controller_alias}\n\n{num_connections} connected",
    "tooltip-format-enumerate-connected": " {device_alias}",
    "tooltip-format-enumerate-connected-battery": " {device_alias}\t{device_battery_percentage}%",
  },

  // Other
  "user": {
    "format": "{user}",
    "interval": 60,
    "icon": false,
  },

  // Media
  "custom/media": {
    "interval": 1,
    "return-type": "json",
    "exec": "~/.config/scripts/hyprland/mediaexec.sh",
    // Left-click switches scope (all players <-> options/mediaplayer),
    // it is not a transport control -- hence the separate bindings.
    "on-click": "~/.config/scripts/hyprland/mediatoggle.sh",
    "on-click-middle": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
  },

  "custom/sidebar": {
    "tooltip": true,
    "tooltip-format": "Notifications",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true,
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/rofi/powermenu.sh",
  },
}
