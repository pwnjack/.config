#!/bin/bash
#
# Pre-commit gate. Activated by install.sh via:
#   git config core.hooksPath scripts/hooks
#
# Tracked in the repo rather than copied into .git/hooks, so it updates with a
# pull and cannot silently diverge from the configs it guards.
#
# Checks staged content only, so an unrelated pre-existing warning elsewhere in
# the repo never blocks an unrelated commit.
#
# Bypass with `git commit --no-verify`.
#
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)" || exit 1
FAILED=0
SNAPSHOT="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$SNAPSHOT"' EXIT

if ! bash "$REPO/scripts/hooks/snapshot.sh" "$REPO" "$SNAPSHOT"; then
    echo "pre-commit: could not export staged files; no checks were run" >&2
    exit 1
fi
mapfile -d '' -t STAGED_SH_PATHS < "$SNAPSHOT/lint-paths"
mapfile -d '' -t STAGED_ALL < "$SNAPSHOT/changed-paths"

# Git may set repository-local variables when invoking hooks. Tests must not
# inherit a route back to the real index, worktree, or object database.
while IFS= read -r name; do
    unset "$name"
done < <(git rev-parse --local-env-vars)
REPO="$SNAPSHOT/worktree"
cd "$REPO" || exit 1

# --- shell scripts --------------------------------------------------------
# The hooks themselves carry no .sh suffix, so they are matched by path as
# well. One case statement, so a hypothetical scripts/hooks/foo.sh is not
# linted twice.
STAGED_SH=()
for _hook_file in "${STAGED_SH_PATHS[@]}"; do
    case "$_hook_file" in
        *.sh|scripts/hooks/*) STAGED_SH+=("$_hook_file") ;;
    esac
done

if [ "${#STAGED_SH[@]}" -gt 0 ]; then
    if command -v shellcheck >/dev/null 2>&1; then
        echo "pre-commit: shellcheck (${#STAGED_SH[@]} file(s))"
        for _hook_file in "${STAGED_SH[@]}"; do
            [ -f "$REPO/$_hook_file" ] || continue
            if ! shellcheck -S warning "$REPO/$_hook_file"; then
                FAILED=1
            fi
        done
    else
        echo "pre-commit: shellcheck not installed, skipping shell lint"
    fi
fi

# --- test suites ----------------------------------------------------------
# Which suites cover which files is test.sh's business, not this hook's: the
# owning-directory rule lives there, so a new suite needs no edit here. Passing
# the staged paths keeps the existing principle that an unrelated pre-existing
# failure never blocks an unrelated commit.
#
# The paths go through exactly as git reports them -- repo-relative. Prefixing
# $REPO would leave them matching no owning directory but the repo root's, so
# the hook would report a green run having tested nothing that was staged.
#
# Output is NOT redirected. test.sh prints one line per suite and a failing
# suite's output in full, so there is no second command to suggest.

if [ "${#STAGED_ALL[@]}" -gt 0 ]; then
    if ! bash "$REPO/test.sh" --for "${STAGED_ALL[@]}"; then
        FAILED=1
    fi
fi

# --- AGS settings panel ---------------------------------------------------
# `ags bundle` is the only compile gate available: there is no tsc, no
# package.json and no node_modules in ags/. esbuild catches syntax errors but
# NOT type errors, so tsconfig's `strict: true` is not enforced here.
#
# The unfiltered list includes deletions and both sides of renames.
AGS_CHANGED=false
for _hook_file in "${STAGED_ALL[@]}"; do
    case "$_hook_file" in ags/*) AGS_CHANGED=true ;; esac
done
if [ "$AGS_CHANGED" = true ]; then
    if command -v ags >/dev/null 2>&1; then
        echo "pre-commit: ags bundle"
        BUNDLE_OUT="$SNAPSHOT/panel.js"
        if ! (cd "$REPO/ags" && ags bundle app.ts "$BUNDLE_OUT" >/dev/null 2>&1); then
            echo "pre-commit: ags bundle failed — run 'cd ags && ags bundle app.ts /tmp/out' to see why"
            FAILED=1
        fi
        rm -f "$BUNDLE_OUT"
    else
        echo "pre-commit: ags not installed, skipping panel build check"
    fi
fi

if [ "$FAILED" -ne 0 ]; then
    echo
    echo "pre-commit: checks failed. Fix the issues above, or bypass with --no-verify."
    exit 1
fi
exit 0
