#!/bin/bash
# Test stand-in for hyprlock: logs its arguments and marks itself running for
# the fake pgrep. FAKE_HYPRLOCK_HOLD (seconds) keeps it alive, holding whatever
# descriptors it inherited, then clears the mark; without it the mark stays.
printf 'args=%s\n' "$*" >> "$FAKE_LOG/hyprlock"
touch "$FAKE_LOG/hyprlock.running"
if [ -n "${FAKE_HYPRLOCK_HOLD:-}" ]; then
    sleep "$FAKE_HYPRLOCK_HOLD"
    rm -f "$FAKE_LOG/hyprlock.running"
fi
